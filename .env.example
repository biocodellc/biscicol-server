# Shared by the Arctos v2 query and download services (Node.js >=20.12).
# Copy to .env. Use an encoded API key with read + view_index_metadata on
# arctos and arctos-*; do not use the importer's elastic superuser account.
ARCTOS_ELASTIC_URL=https://huxley.bnhm.berkeley.edu:1113/
ARCTOS_ELASTIC_INDEX=arctos
ARCTOS_ELASTIC_API_KEY=
ARCTOS_QUERY_V2_PORT=3623
ARCTOS_DOWNLOAD_V2_PORT=3624
ARCTOS_V2_BIND_HOST=127.0.0.1
ARCTOS_ELASTIC_TIMEOUT_MS=30000
ARCTOS_V2_TMP_DIR=/home/exouser/data/tmp

# Alternatively, use a dedicated read-only user:
# ARCTOS_ELASTIC_USERNAME=
# ARCTOS_ELASTIC_PASSWORD=

# Only needed for a backend signed by a private CA; Huxley uses system trust.
# ARCTOS_ELASTIC_CA_CERT=/path/to/http_ca.crt

# Set BISCICOL_ENV_FILE in the process environment for a different .env path.
